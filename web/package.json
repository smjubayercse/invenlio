{
  "name": "invenlio-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src e2e index.html vite.config.ts playwright.config.ts eslint.config.js",
    "lint": "eslint src e2e playwright.config.ts --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@mantine/modals": "8.3.11",
    "@mantine/notifications": "8.3.11",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.103.2",
    "keycloak-js": "26.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
