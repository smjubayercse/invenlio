# Development-only defaults. Never reuse these credentials outside local development.
POSTGRES_DB=invenlio
POSTGRES_USER=invenlio
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ONLY_ADMIN_PASSWORD
KEYCLOAK_REALM=invenlio
KEYCLOAK_CLIENT_ID=invenlio-api
SPRING_PROFILES_ACTIVE=local
KEYCLOAK_HTTP_PORT=8081
BACKEND_HTTP_PORT=8080
VITE_OIDC_URL=http://localhost:8081
OIDC_ISSUER_URI=http://localhost:8081/realms/invenlio
OIDC_JWK_SET_URI=http://host.docker.internal:8081/realms/invenlio/protocol/openid-connect/certs
